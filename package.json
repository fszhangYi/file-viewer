{
  "name": "file-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local directory file preview server (Web UI + optional Electron shell)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/cli.cjs",
    "start:ui": "env -u VITE_DEV_SERVER_URL electron . --ui",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.2",
    "docx-preview": "^0.3.5",
    "fflate": "^0.8.3",
    "occt-import-js": "^0.0.12",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-pdf": "^9.2.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.173.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.68.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "~5.7.3",
    "vite": "^5.4.14",
    "wait-on": "^8.0.2"
  },
  "optionalDependencies": {
    "electron": "^34.2.0"
  }
}
